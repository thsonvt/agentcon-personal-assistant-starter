# Copy to .env once, then edit privately. Never commit .env.
# --- Local workshop: these Google values are the only required credentials. ---
# Create a Web application OAuth client. Authorized redirect URI (exact):
# http://127.0.0.1:8016/signup/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
DB_PATH=./data/workshop.db
OWNER_NAME=
# Optional: required for AI chat/scheduling, not the direct Calendar view.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional web voice; both are needed for spoken replies.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Advanced full runtime below: NOT required by scripts/run_web_local.py. ---
# Optional: speech-to-text model for voice notes (default whisper-1; gpt-4o-mini-transcribe also works)
OPENAI_TRANSCRIBE_MODEL=
# The owner's spoken language; use auto for multilingual notes. Other users use auto.
OWNER_VOICE_LANGUAGE=en
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
# Your own WhatsApp number, any format (e.g. +65 9123 4567)
OWNER_WHATSAPP=
# Browser workshop sign-in stores its encrypted token in the DB, not this field.
GOOGLE_REFRESH_TOKEN=
CALENDLY_TOKEN=
CALENDLY_EVENT_TYPE_URI=
# --- Optional: let friends sign up (Plan 2B). Set all six, or none. ---
# Google Cloud → Credentials → OAuth client of type "Web application",
# redirect URI: <BASE_URL>/signup/callback
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
# e.g. https://your-app.up.railway.app (no trailing slash)
BASE_URL=
# The bot's own WhatsApp number (for the wa.me button), e.g. +1 555 000 1234
BOT_WHATSAPP=
# Generate both with: python scripts/check_setup.py --new-key
TOKEN_KEY=
SESSION_SECRET=
# Pippa + friends; Meta's test number allows 5 recipients, Pippa included
MAX_USERS=5
# Automatic activation is restricted to these exact beta Google email addresses.
# Leave false until eligible emails and the WhatsApp transport are configured.
BETA_AUTO_APPROVE=false
BETA_ALLOWED_EMAILS=
# True while using Meta's test number; set false only for a verified production sender.
WHATSAPP_TEST_MODE=true
# Event attendee pilot: requires the six sign-up settings above. Enable only after preflight.
# Roll back by setting false and restarting; preserve the database and entitlement-aware code.
EVENT_NETWORKING_ENABLED=false
# --- Protected public waitlist (advanced opt-in; configure your own providers before enabling) ---
WAITLIST_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# API key for your own Loops workspace; never expose it in HTML/JS.
LOOPS_API_KEY=
LOOPS_WAITLIST_LIST_ID=
WAITLIST_ORIGIN=https://example.com
# On Railway, use /data/waitlist.sqlite3 for persistent counters.
WAITLIST_STATE_PATH=./data/waitlist.sqlite3
# Optional dedicated random secret; falls back to SESSION_SECRET.
WAITLIST_RATE_SECRET=
# Leave empty until the proxy chain is verified. Never use 0.0.0.0/0 or ::/0.
WAITLIST_TRUSTED_PROXY_CIDRS=

# Set railway only for exclusive Railway HTTP ingress after the header spoofing check.
WAITLIST_CLIENT_IP_SOURCE=socket

# Conference capture pilot (one application worker/replica, persistent DB volume).
# Requires the complete signup configuration, HTTPS BASE_URL and SESSION_SECRET.
CONFERENCE_CAPTURE_ENABLED=false
# Optional vision + structured-output model override; defaults to OPENAI_MODEL.
CAPTURE_MODEL=
# Opt-in private meeting briefs; one worker/replica and persistent DB volume.
PROACTIVE_BRIEFS_ENABLED=false
# Private follow-ups from supplied notes/text/voice; enable after local review.
FOLLOWUPS_ENABLED=false
# Optional existing, approved WhatsApp template with one body variable (English).
# Without it, closed reply windows queue reminders until the user's next message.
FOLLOWUP_REMINDER_TEMPLATE=
# Published Loops transactional template for public booking host confirmations.
# Uses the existing LOOPS_API_KEY; no guest marketing email is added.
LOOPS_BOOKING_HOST_EMAIL_ID=
